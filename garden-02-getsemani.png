/* Get Women Experience — Typography tokens
   Elegant classic serif, all-caps display with open kerning; wedding-invite hierarchy.
   NOTE: no brand font files were supplied — Google Fonts substitutes are used (see fonts.css).
   Cormorant Garamond ≈ display serif, EB Garamond ≈ text serif. */
:root{
  --font-display:"Cormorant Garamond","Cormorant",Georgia,"Times New Roman",serif;
  --font-serif:"EB Garamond",Georgia,"Times New Roman",serif;
  --font-sans:"Jost","Century Gothic",-apple-system,"Helvetica Neue",Arial,sans-serif; /* complementary geometric sans for small labels */

  /* Weights */
  --fw-light:300;    /* @kind font */
  --fw-regular:400;  /* @kind font */
  --fw-medium:500;   /* @kind font */
  --fw-semibold:600; /* @kind font */

  /* Type scale (event / invitation rhythm) */
  --fs-hero:clamp(3.5rem,8vw,7rem); /* @kind font */
  --fs-display:clamp(2.5rem,5vw,4rem); /* @kind font */
  --fs-h1:2.5rem;
  --fs-h2:1.875rem;
  --fs-h3:1.375rem;
  --fs-body-lg:1.125rem;
  --fs-body:1rem;
  --fs-small:0.875rem;
  --fs-label:0.75rem;      /* spaced all-caps labels */

  /* Line heights */
  --lh-tight:1.05;   /* @kind font */
  --lh-snug:1.25;    /* @kind font */
  --lh-normal:1.55;  /* @kind font */
  --lh-relaxed:1.7;  /* @kind font */

  /* Letter spacing — the signature of the brand: wide tracking on caps */
  --ls-hero:0.18em;     /* @kind font */
  --ls-label:0.34em;    /* EXPERIENCE / DE OUTUBRO @kind font */
  --ls-caps:0.22em;     /* @kind font */
  --ls-body:0.01em;     /* @kind font */

  /* Semantic roles */
  --type-wordmark-family:var(--font-display);
  --type-wordmark-weight:var(--fw-regular);
  --type-heading-family:var(--font-display);
  --type-body-family:var(--font-serif);
  --type-label-family:var(--font-sans);
}
